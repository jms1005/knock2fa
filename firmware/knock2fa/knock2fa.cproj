      <Link>timebase.c</Link>
    </Compile>
    <Compile Include="..\common\timebase.h">
      <SubType>compile</SubType>
      <Link>timebase.h</Link>
    </Compile>
    <Compile Include="..\common\authstore.c">
      <SubType>compile</SubType>
      <Link>authstore.c</Link>
    </Compile>
    <Compile Include="..\common\authstore.h">
      <SubType>compile</SubType>
      <Link>authstore.h</Link>
    </Compile>
    <Compile Include="..\common\classify.c">
      <SubType>compile</SubType>
      <Link>classify.c</Link>
    </Compile>
    <Compile Include="..\common\classify.h">
