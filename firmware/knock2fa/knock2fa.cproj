      <Link>knockfp.h</Link>
    </Compile>
    <Compile Include="..\common\keypad.c">
      <SubType>compile</SubType>
      <Link>keypad.c</Link>
    </Compile>
    <Compile Include="..\common\keypad.h">
      <SubType>compile</SubType>
      <Link>keypad.h</Link>
    </Compile>
    <Compile Include="..\common\timebase.c">
